{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "email-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-03",

  // Served on <name>.<subdomain>.workers.dev. To use a custom domain, attach it in the
  // dashboard (Worker → Settings → Domains & Routes) or add a "routes" entry here:
  //   "routes": [{ "pattern": "email.example.com", "custom_domain": true }]
  "workers_dev": true,

  // Workers Logs: console output and request traces in the dashboard.
  // Static files in ./public (e.g. /og.png) are served directly; other paths hit the Worker.
  "assets": {
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  // Sends from FROM_EMAIL, which must be on a domain onboarded to Email Service.
  // Optionally lock the binding down with "allowed_sender_addresses": ["noreply@example.com"].
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  // Set with `wrangler secret put <NAME>` (production) or .dev.vars (local).
  // FORWARD_TO is optional and only needed for inbound forwarding.
  "secrets": {
    "required": ["API_KEY", "FROM_EMAIL", "FROM_NAME"]
  }
}
